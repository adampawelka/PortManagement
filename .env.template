# ============================================================================
# PORT MANAGEMENT SYSTEM - ENVIRONMENT VARIABLES
# ============================================================================

# DATABASE CONFIGURATION
# ----------------------------------------------------------------------------

# PostgreSQL (Backend API)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=portmanagementdb
DB_USER=portapp
DB_PASSWORD=PortManagement123!

# MongoDB (OEM Module)
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=oemdb
MONGO_USER=admin
MONGO_PASSWORD=ChangeThisMongoPassword123!
MONGODB_URI=mongodb://admin:${MONGO_PASSWORD}@mongo:27017/oemdb?authSource=admin

# API CONFIGURATION
# ----------------------------------------------------------------------------
PORT=5161
NODE_ENV=production

# EXTERNAL SERVICES
BACKEND_API_URL=http://backend:5000
SCHEDULING_API_URL=http://scheduling:5107

# SECURITY
JWT_SECRET=ChangeThisJWTSecretKeyForProduction123!
CORS_ORIGINS=http://localhost:5173,http://localhost:5000,http://localhost:5161

# AUTH0 CONFIGURATION (if using)
AUTH0_DOMAIN=3dl-e-04.eu.auth0.com
AUTH0_AUDIENCE=http://3dl-e-04api
AUTH0_CLIENT_ID=your_client_id_here

# LOGGING
LOG_LEVEL=info
LOG_FILE=/opt/port-management/logs/oem.log

# DOCKER CONFIGURATION
DOCKER_NETWORK=portmanagement-network

# DEPLOYMENT
RELEASE_VERSION=1.0.0
DEPLOYMENT_ENV=production

