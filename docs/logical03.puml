@startuml
!define RECTANGLE class

skinparam packageStyle rectangle

title Logical View - Level 3

package "Port Management System" {
    package "Port Operations Management" {
        [Dock Management] as DM
        [Storage Area\nManagement] as SAM
        [Vessel Visit\nNotification] as VVN

        DM -down-> SAM : distance mapping
    }

    package "Vessel & Agent Management" {
        [Vessel Registry] as VR
        [Vessel Type\nCatalog] as VTC
        [Shipping Agent\nOrganization] as SAO
        [Shipping Agent\nRepresentative] as SAR_M

        VR --> VTC : references
        SAO --> SAR_M : manages
        VR --> SAO : operator
    }

    package "Resource & Staff Management" {
        [Physical Resource\nManagement] as PRM
        [Staff Member\nManagement] as SMM
        [Qualification\nRegistry] as QR
        [User & Authorization\nManagement] as UAM

        PRM --> QR : requires
        SMM --> QR : holds
    }

    package "Planning & Scheduling Engine" {
        [Schedule\nComputation] as SC
        [Dock Assignment\nAlgorithm] as DAA
        [Resource Allocation\nAlgorithm] as RAA

        DAA --> SC : inputs
        RAA --> SC : inputs
    }

    package "3D Visualization Module" {
        [Scene Renderer] as SR
        [Camera Controller] as CC
        [Model Loader] as ML

        SR --> ML : uses models
        CC --> SR : controls view
    }

    ' Cross-package relationships
    VVN --> VR : references vessel
    VVN --> SAR_M : submitted by
    VVN --> DM : assigned to dock
    VVN --> SAM : cargo location

    SC ..> VVN : consumes visit data
    SC ..> PRM : consumes resources
    SC ..> SMM : consumes staff
    SC ..> DM : consumes dock info

    SR ..> DM : renders docks
    SR ..> SAM : renders storage
    SR ..> VVN : renders vessels
    SR ..> PRM : renders resources

    UAM --> SAR_M : associates user

}

actor "Port Authority\nOfficer" as PAO
actor "Shipping Agent\nRepresentative" as SAR
actor "Logistics\nOperator" as LO
actor "System\nAdministrator" as ADMIN

component "External IAM\nProvider" as IAM <<external>>
database "System\nDatabase" as DB

' User interactions
PAO --> "Port Management System"
SAR --> "Port Management System"
LO --> "Port Management System"
ADMIN --> "Port Management System"

' System interactions
"Port Operations Management" --> DB : Reads/Writes
"Vessel & Agent Management" --> DB : Reads/Writes
"Resource & Staff Management" --> DB : Reads/Writes
"Planning & Scheduling Engine" ..> "Port Operations Management" : Consumes\nvisit data
"Planning & Scheduling Engine" ..> "Resource & Staff Management" : Consumes\nresource data
"3D Visualization Module" ..> "Port Operations Management" : Reads facility\n& visit data
"3D Visualization Module" ..> "Resource & Staff Management" : Reads resource\ndata

' Authentication
PAO -> IAM : Authenticates
SAR -> IAM : Authenticates
LO -> IAM : Authenticates
ADMIN -> IAM : Authenticates


@enduml