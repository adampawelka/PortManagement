package "3D Visualization Module" {
    package "Scene Renderer" <<Rectangle>> {
        class SceneRenderer {
        }
    }

    package "Camera Controller" <<Rectangle>> {
        class CameraController {
        }
    }

    package "Model Loader" <<Rectangle>> {
        class ModelLoader {
        }
    }

    SceneRenderer --> ModelLoader : uses
    CameraController --> SceneRenderer : controls
}

' Cross-package relationships
VesselVisitNotification --> Vessel : references
VesselVisitNotification --> ShippingAgentRepresentative : submitted by
VesselVisitNotification --> Dock : assigned to
VesselVisitNotificationService ..> VesselService : uses

OptimalScheduler ..> VesselVisitNotificationService : consumes visit data
OptimalScheduler ..> ResourceService : consumes resources
OptimalScheduler ..> StaffMemberService : consumes staff
OptimalScheduler ..> DockService : consumes dock info

SceneRenderer ..> DockService : fetches docks
SceneRenderer ..> StorageAreaService : fetches storage areas
SceneRenderer ..> VesselVisitNotificationService : fetches vessels
SceneRenderer ..> ResourceService : fetches resources

User --> ShippingAgentRepresentative : associates with


