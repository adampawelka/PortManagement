@startuml implementation03
skinparam packageStyle rectangle
skinparam monochrome true

title Implementation View - Level 3\nPort Management System

package "Port Operations Management" {
    package "Dock Management" <<Rectangle>> {
        class DocksController {
        }

        class DockService {
        }

        interface IDockRepository {
        }

        class DockRepository {
        }

        class Dock <<Aggregate Root>> {
        }

        DocksController --> DockService
        DockService --> IDockRepository
        DockRepository ..|> IDockRepository
        DockRepository --> Dock
        DockService ..> Dock
    }

    package "Storage Area Management" <<Rectangle>> {
        class StorageAreasController {
        }

        class StorageAreaService {
          }

        class StorageArea <<Aggregate Root>> {
        }

        StorageAreasController --> StorageAreaService
        StorageAreaService --> StorageArea
    }

    package "Vessel Visit Notification" <<Rectangle>> {
        class VesselVisitNotificationsController {
        }

        class VesselVisitNotificationService {
        }

        class VesselVisitNotification <<Aggregate Root>> {
        }

        VesselVisitNotificationsController --> VesselVisitNotificationService
        VesselVisitNotificationService --> VesselVisitNotification
        VesselVisitNotificationService ..> DockService
    }
}

