    }
    class email <<ValueObject>> {
    }
    class phone <<ValueObject>> {
    }
    HumanResource "1" *-- "1" mecanographicNumber
    HumanResource "1" *-- "1" shortName
    HumanResource "1" *-- "1" email
    HumanResource "1" *-- "1" phone
}
HumanResource -up-|> Resource

