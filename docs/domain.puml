package "<<Aggregate>> User" {
    class User <<Entity>> <<Root>> {
    }
    class userId <<ValueObject>> {
    }
    class profile <<ValueObject>> {
        PORT_AUTHORITY_OFFICER
        SHIPPING_AGENT_REPRESENTATIVE
        LOGISTICS_OPERATOR
        ADMINISTRATOR
    }
    class permissions <<ValueObject>> {
    }
    User "1" *-- "1" userId
    User "1" *-- "1" profile
    User "1" *-- "1..*" permissions
}

' Relationships
Port "1" *-- "1..*" Facility : hasFacilities >
Facility <|-- Dock
Facility <|-- StorageArea
StorageArea "1" *-- "0..*" Dock : serves >
StorageArea "1" *-- "0..*" Distance : toDocks
Dock "1" *-- "1..*" VesselType : allowedTypes >
PhysicalResource "1" -- "0..1" Facility : assignedTo >
PhysicalResource "1" *-- "1..*" Qualification : requires >
HumanResource "1" *-- "1..*" Qualification :  >
Vessel "1" *-- "1" VesselType
Vessel "1" *-- "1" ShippingAgentOrganization : operator >
ShippingAgentOrganization "1" *-- "1..*" ShippingAgentRepresentative
VesselVisit "1" *-- "1" Vessel
VesselVisit "1" *-- "1" ShippingAgentRepresentative : notifiedBy >
VesselVisit "1" *-- "0..1" Dock : assignedTo
VesselVisit "1" *-- "0..2" CargoManifest
VesselVisit "1" *-- "1..*" Task
CargoManifest "1" *-- "1..*" Container
Task "1" *-- "1..*" Resource : uses >
Task "1" *-- "0..*" Task : dependsOn >
User "1" *-- "0..1" ShippingAgentRepresentative : associatedWith
User "1" -- "0..*" VesselVisit : manages
User "1" -- "0..*" Task : assigns

@enduml