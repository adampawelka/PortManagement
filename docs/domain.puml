@startuml
skinparam monochrome true
skinparam linetype ortho

abstract class Resource <<Entity>> <<Root>> {
}
class resourceId <<ValueObject>> {
}
class operationalWindow <<ValueObject>> {
}
class resourceStatus <<ValueObject>> {
    AVAILABLE
    UNAVAILABLE
    MAINTENANCE
}
class setupTime <<ValueObject>> {
}
Resource "1" *-- "1" resourceId
Resource "1" *-- "1" operationalWindow
Resource "1" *-- "1" resourceStatus
Resource "1" *-- "1" setupTime

package "<<Aggregate>> PhysicalResource" {
    class PhysicalResource <<Entity>> <<Root>> {
    }
    class physicalType <<ValueObject>> {
        STS_CRANE
        YARD_GANTRY_CRANE
        TRUCK
    }
    class capacity <<ValueObject>> {
    }
    PhysicalResource "1" *-- "1" physicalType
    PhysicalResource "1" *-- "1" capacity
}
PhysicalResource -up-|> Resource

