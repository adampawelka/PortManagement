Vessel "1" *-- "1" ShippingAgentOrganization
ShippingAgentOrganization "1" *-- "1..*" ShippingAgentRepresentative
PhysicalResource "1" *-- "1..*" HumanResource
Task "1" *-- "1..*" Resource
