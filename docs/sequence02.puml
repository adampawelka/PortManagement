@startuml
skinparam monochrome true

participant "Web UI" as UI
participant "ShippingAgents\nController" as Controller
participant "ShippingAgentO\nService" as Service
participant "ShippingAgent\nOrganization\n(Entity)" as Entity
participant "ShippingAgentO\nRepository" as Repo
participant "DbContext" as DB
participant "UnitOfWork" as UOW

== US06: Register Shipping Agent Organization ==

UI -> Controller : POST /api/ShippingAgents\n{dto}
activate Controller

Controller -> Service : RegisterOrganizationAsync(dto)
activate Service

Service -> Service : Validate DTO
Service -> Service : Generate unique ID

Service -> Repo : GetByIdAsync(id)
activate Repo
Repo -> DB : Find by ID
activate DB
DB --> Repo : null (not found)
deactivate DB
Repo --> Service : null
deactivate Repo

Service -> Entity : new ShippingAgentOrganization(...)
activate Entity
Entity -> Entity : Validate business rules
Entity --> Service : organization instance
deactivate Entity

Service -> Repo : AddAsync(organization)
activate Repo
Repo -> DB : Add to ChangeTracker
DB --> Repo : tracked entity
deactivate Repo

Service -> UOW : CommitAsync()
activate UOW
UOW -> DB : SaveChangesAsync()
activate DB
DB -> DB : Generate SQL INSERT
DB -> DB : Execute transaction
DB --> UOW : rows affected
deactivate DB
UOW --> Service : success
deactivate UOW

Service -> Service : MapToDto(organization)
Service --> Controller : OrganizationDto
deactivate Service

Controller --> UI : 201 Created\n{organizationDto}
deactivate Controller

note over UI, UOW
  Standard DDD flow:
  Controller → Service → Entity → Repository → DbContext

  Entity enforces business rules
  Repository abstracts data access
  UnitOfWork manages transactions
end note

@enduml