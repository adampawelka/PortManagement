@startuml
!define RECTANGLE class
skinparam linetype ortho
skinparam packageStyle rectangle

title Logical View - Level 2

package "Port Management System" {
    [Port Operations\nManagement] as POM
    [Resource & Staff\nManagement] as RSM
    [Vessel & Agent\nManagement] as VAM
    [Planning & Scheduling\nEngine] as PSE
    [3D Visualization\nModule] as VIZ
}

actor "Port Authority\nOfficer" as PAO
actor "Shipping Agent\nRepresentative" as SAR
actor "Logistics\nOperator" as LO
actor "System\nAdministrator" as ADMIN

component "External IAM\nProvider" as IAM <<external>>
database "System\nDatabase" as DB

' User interactions
PAO --> "Port Management System"
SAR --> "Port Management System"
LO --> "Port Management System"
ADMIN --> "Port Management System"

' System interactions
POM --> DB : Reads/Writes
VAM --> DB : Reads/Writes
RSM --> DB : Reads/Writes
PSE ..> POM : Consumes\nvisit data
PSE ..> RSM : Consumes\nresource data
VIZ ..> POM : Reads facility\n& visit data
VIZ ..> RSM : Reads resource\ndata

' Authentication
PAO -> IAM : Authenticates
SAR -> IAM : Authenticates
LO -> IAM : Authenticates
ADMIN -> IAM : Authenticates


@enduml